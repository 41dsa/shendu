# Database
# Local dev without Docker:
DATABASE_URL=sqlite:///./shendu_dev.db
# Production:
# DATABASE_URL=postgresql+psycopg://shendu:shendu@localhost:5432/shendu

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Security (generate: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=change-me-jwt-secret-min-32-chars-long!!
MASTER_KEY=change-me-master-key-32-bytes-hex-64chars0000000000000000000000000000

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
JWT_EXPIRE_MINUTES=10080

# Optional: first admin (created on register if email matches)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# External links
AFDIAN_PLAN_URL=https://afdian.net/@your-page/plan
